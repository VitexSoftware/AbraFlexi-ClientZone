{
    "name": "vitexsoftware/abraflexi-clientzone",
    "description": "Client Zone for AbraFlexi",
    "version": "2.0",
    "type": "project",
    "authors": [
        {
            "name": "Vítězslav Dvořák",
            "email": "info@vitexsoftware.cz"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-curl": "*",
        "spojenet/flexibee": "^3.7",
        "vitexsoftware/ease-core": "^1.50",
        "vitexsoftware/ease-twbootstrap5": ">=1.2.0",
        "vitexsoftware/abraflexi-bricks": ">=1.5.0",
        "vitexsoftware/ease-bootstrap5-widgets-abraflexi": "dev-main",
        "vitexsoftware/ease-html-widgets": "dev-main",
        "vitexsoftware/datatables-abraflexi": "^1.2",
        "robmorgan/phinx": "*"
    },
    "autoload": {
        "psr-4": {
            "ClientZone\\": "src/ClientZone/",
            "ClientZone\\ui\\": "src/ClientZone/ui/",
            "ClientZone\\orderplugins\\": "src/ClientZone/orderplugins/",
            "Test\\ClientZone\\": "tests/src/ClientZone/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "phpstan/phpstan": "*",
        "friendsofphp/php-cs-fixer": "^3"
    }
}

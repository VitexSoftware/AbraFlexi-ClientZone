#!/bin/sh
# debconf configuration for abraflexi-clientzone-subreg

set -e
. /usr/share/debconf/confmodule

db_input high "clientzone/SUBREG_LOCATION" || true
db_go || true
db_input high "clientzone/SUBREG_URI" || true
db_go || true
db_input high "clientzone/SUBREG_LOGIN" || true
db_go || true
db_input high "clientzone/SUBREG_PASSWORD" || true
db_go || true

exit 0

#!/bin/bash
# postinst script for abraflexi-clientzone

set -e
. /usr/share/debconf/confmodule

db_get "clientzone/WEBUSER"
WEBUSER="${RET:-www-data}"

ENV_DIR="/etc/abraflexi-client-zone"
ENV_FILE="${ENV_DIR}/.env"

mkdir -p "$ENV_DIR"
if [ ! -f "$ENV_FILE" ]; then
    touch "$ENV_FILE"
fi
# Readable by the web server user (debconf WEBUSER), writable by root
chmod 0640 "$ENV_FILE"
if id "$WEBUSER" >/dev/null 2>&1; then
    chown "root:${WEBUSER}" "$ENV_FILE" || chown "root:www-data" "$ENV_FILE" || true
else
    chown root:www-data "$ENV_FILE" || true
fi

replaceENV() {
    local key="$1"
    local value="$2"
    # escape sed replacement metacharacters in value
    local escaped
    escaped=$(printf '%s' "$value" | sed -e 's/[&|\\]/\\&/g')
    if grep -q "^${key}=" "$ENV_FILE" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=\"${escaped}\"|" "$ENV_FILE"
    else
        echo "${key}=\"${value}\"" >> "$ENV_FILE"
    fi
}

listOfConfigs="
SEND_MAILS_FROM
SEND_INFO_TO
EMAIL_FROM
EASE_EMAILTO
SUPPRESS_EMAILS
ALLOW_REGISTER
REGISTER_USERNAME_IS_EMAIL
REGISTER_VERIFY_EMAIL
CLIENTZONE_URL
SHOW_PRICELIST
PROD_CAT
DEBUG
EASE_LOGGER
ABRAFLEXI_URL
ABRAFLEXI_LOGIN
ABRAFLEXI_PASSWORD
ABRAFLEXI_COMPANY
ABRAFLEXI_PASSWORD_HASH
ABRAFLEXI_PASSWORD_SALT
ABRAFLEXI_PROFORMA_DOCTYPE
ABRAFLEXI_BANK_DOCTYPE
ABRAFLEXI_STORAGE
IPEX_URL
IPEX_LOGIN
IPEX_PASSWORD
SUBREG_LOCATION
SUBREG_URI
SUBREG_LOGIN
SUBREG_PASSWORD
"

for keyword in $listOfConfigs; do
    db_get "clientzone/$keyword" || true
    replaceENV "$keyword" "${RET}"
done

replaceENV "CONFIGURED" "true"

# Random secret for e-mail verification links, generated once and never asked for
if ! grep -q '^REGISTRATION_SECRET=".\{32,\}"' "$ENV_FILE" 2>/dev/null; then
    replaceENV "REGISTRATION_SECRET" "$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
fi

# Migrate legacy config path if present and new file was empty of ABRAFLEXI_URL
if [ -f /etc/abraflexi/clientzone.env ] && ! grep -q '^ABRAFLEXI_URL=.\+' "$ENV_FILE" 2>/dev/null; then
    echo "abraflexi-clientzone: merging legacy /etc/abraflexi/clientzone.env into ${ENV_FILE}" >&2
    cat /etc/abraflexi/clientzone.env >> "$ENV_FILE"
fi

# Remove botched install that put the conf into a directory of the same name
if [ -d /etc/apache2/conf-available/abraflexi-clientzone.conf ]; then
    echo "abraflexi-clientzone: replacing directory leftover at conf-available/abraflexi-clientzone.conf" >&2
    rm -rf /etc/apache2/conf-available/abraflexi-clientzone.conf
fi
if [ -L /etc/apache2/conf-enabled/abraflexi-clientzone.conf ] || [ -d /etc/apache2/conf-enabled/abraflexi-clientzone.conf ]; then
    rm -rf /etc/apache2/conf-enabled/abraflexi-clientzone.conf
fi
# Ensure the Apache conf file from this package is present (dpkg skips replace when a dir was there)
PKG_CONF_SRC="/usr/share/abraflexi-clientzone/apache/abraflexi-clientzone.conf"
if [ ! -f /etc/apache2/conf-available/abraflexi-clientzone.conf ]; then
    if [ -f "$PKG_CONF_SRC" ]; then
        install -m 0644 "$PKG_CONF_SRC" /etc/apache2/conf-available/abraflexi-clientzone.conf
    fi
fi

if [ -x /usr/sbin/a2enconf ] && [ -f /etc/apache2/conf-available/abraflexi-clientzone.conf ]; then
    a2enconf abraflexi-clientzone 2>/dev/null || true
fi

if [ -f /bin/systemctl ]; then
    if [ -f /lib/systemd/system/apache2.service ]; then
        systemctl reload apache2 3>/dev/null || true
    fi
    if [ -f /lib/systemd/system/avahi-daemon.service ]; then
        systemctl reload avahi-daemon 3>/dev/null || true
    fi
fi

mkdir -p /var/cache/abraflexi-clientzone /var/lib/abraflexi-clientzone/tmp
chown "${WEBUSER}:${WEBUSER}" -R /var/cache/abraflexi-clientzone /var/lib/abraflexi-clientzone 2>/dev/null || true

# No local administrator account — customers authenticate against AbraFlexi
# contacts; privileged config is /etc/abraflexi-client-zone/.env (SSH).

#DEBHELPER#

exit 0

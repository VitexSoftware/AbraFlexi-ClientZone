#!/usr/bin/make -f

PKG_VERSION := $(shell dpkg-parsechangelog -S Version | sed 's/~.*//')
PKG_SOURCE  := $(shell jq -r '.name' composer.json)
PKG_TYPE    := $(shell jq -r '.type' composer.json)

%:
	dh $@

override_dh_auto_test:
	appstreamcli validate --pedantic --no-net \
	    debian/abraflexi-clientzone.metainfo.xml

override_dh_install:
	dh_install
	install -m 644 debian/autoload.php \
	    debian/abraflexi-clientzone/usr/share/abraflexi-clientzone/autoload.php
	sed -i "1a defined('APP_NAME') || define('APP_NAME', '$(PKG_SOURCE)');" \
	    debian/abraflexi-clientzone/usr/share/abraflexi-clientzone/autoload.php
	sed -i "s|'unknown'|'$(PKG_SOURCE)'|" \
	    debian/abraflexi-clientzone/usr/share/abraflexi-clientzone/autoload.php
	sed -i "s|'0.0.0'|'$(PKG_VERSION)'|" \
	    debian/abraflexi-clientzone/usr/share/abraflexi-clientzone/autoload.php
	sed -i "s|'library'|'$(PKG_TYPE)'|g" \
	    debian/abraflexi-clientzone/usr/share/abraflexi-clientzone/autoload.php
	sed -i "2a defined('APP_VERSION') || define('APP_VERSION', '$(PKG_VERSION)');" \
	    debian/abraflexi-clientzone/usr/share/abraflexi-clientzone/autoload.php
	# Ensure entry points load the Debian autoloader
	find debian/abraflexi-clientzone/usr/share/abraflexi-clientzone -name '*.php' -print0 \
	    | xargs -0 sed -i \
	    -e "s|require_once __DIR__.'/../vendor/autoload.php';|require_once '/usr/share/abraflexi-clientzone/autoload.php';|g" \
	    -e "s|require_once '../vendor/autoload.php';|require_once '/usr/share/abraflexi-clientzone/autoload.php';|g" \
	    || true

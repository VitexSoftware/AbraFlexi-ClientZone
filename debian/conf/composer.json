{
    "name": "deb/abraflexi-clientzone",
    "description": "AbraFlexi ClientZone",
    "version": "2.1",
    "authors": [
        {
            "name": "Vítězslav Dvořák",
            "email": "info@vitexsoftware.cz"
        }
    ],
    "config": {
        "vendor-dir": "/var/lib/abraflexi-clientzone"
    },
    "require": {
        "deb/php-spojenet-abraflexi": "*",
        "deb/php-vitexsoftware-abraflexi-bricks": "*",
        "deb/php-vitexsoftware-ease-bootstrap5": "*",
        "deb/php-vitexsoftware-ease-bootstrap5-widgets": "*",
        "deb/php-vitexsoftware-ease-bootstrap5-widgets-abraflexi": "*",
        "deb/php-vitexsoftware-ease-html-widgets": "*"
    },
    "autoload": {
        "psr-4": {
            "ClientZone\\": "ClientZone/",
            "ClientZone\\ui\\": "ClientZone/ui/",
            "ClientZone\\orderplugins\\": "ClientZone/orderplugins/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "/usr/share/php/AbraFlexi",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "/usr/share/php/AbraFlexiBricks",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "/usr/share/php/EaseTWB5Widgets",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "/usr/share/php/EaseTWB5WidgetsAbraFlexi",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "/usr/share/php/EaseHtmlWidgets",
            "options": { "symlink": true }
        }
    ]
}

#!/bin/sh
# debconf configuration for abraflexi-clientzone

set -e
. /usr/share/debconf/confmodule

ask() {
    db_input high "clientzone/$1" || true
    db_go || true
}

ask WEBUSER

ask ABRAFLEXI_URL
ask ABRAFLEXI_LOGIN
ask ABRAFLEXI_PASSWORD
ask ABRAFLEXI_COMPANY
ask ABRAFLEXI_PROFORMA_DOCTYPE
ask ABRAFLEXI_BANK_DOCTYPE
ask ABRAFLEXI_STORAGE

ask SEND_MAILS_FROM
ask SEND_INFO_TO
ask EMAIL_FROM
ask EASE_EMAILTO
ask SUPPRESS_EMAILS
ask ALLOW_REGISTER
ask SHOW_PRICELIST
ask PROD_CAT
ask DEBUG
ask EASE_LOGGER

ask IPEX_URL
ask IPEX_LOGIN
ask IPEX_PASSWORD

ask SUBREG_LOCATION
ask SUBREG_URI
ask SUBREG_LOGIN
ask SUBREG_PASSWORD

ask ADMIN_LOGIN
ask ADMIN_PASSWORD

ENV_DIR="/etc/abraflexi-client-zone"
ENV_FILE="${ENV_DIR}/.env"

if [ ! -f "$ENV_FILE" ]; then
    mkdir -p "$ENV_DIR"
    cat > "$ENV_FILE" <<'EOF'
# Generated by abraflexi-clientzone package
CONFIGURED="false"
EASE_LOGGER="syslog"
EOF
    chmod 0640 "$ENV_FILE"
fi

#DEBHELPER#

exit 0

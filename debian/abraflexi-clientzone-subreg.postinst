#!/bin/sh
# postinst script for abraflexi-clientzone-subreg
# Writes subreg credentials to a drop-in file read by ClientZone Init.

set -e
. /usr/share/debconf/confmodule

ENV_DIR="/etc/abraflexi-client-zone"
CONF_D="${ENV_DIR}/conf.d"
CONF_FILE="${CONF_D}/subreg.env"
CORE_ENV="${ENV_DIR}/.env"

case "$1" in
    configure)
        db_get "clientzone/WEBUSER" || true
        WEBUSER="${RET:-www-data}"

        mkdir -p "$CONF_D"
        {
            echo "# Generated by abraflexi-clientzone-subreg package"
            db_get "clientzone/SUBREG_LOCATION" || true
            printf 'SUBREG_LOCATION="%s"\n' "$RET"
            db_get "clientzone/SUBREG_URI" || true
            printf 'SUBREG_URI="%s"\n' "$RET"
            db_get "clientzone/SUBREG_LOGIN" || true
            printf 'SUBREG_LOGIN="%s"\n' "$RET"
            db_get "clientzone/SUBREG_PASSWORD" || true
            printf 'SUBREG_PASSWORD="%s"\n' "$RET"
        } > "$CONF_FILE"
        chmod 0640 "$CONF_FILE"
        chown "root:${WEBUSER}" "$CONF_FILE" 2>/dev/null || chown root:www-data "$CONF_FILE" || true

        # Values moved here from the core .env (before ClientZone 2.7.0)
        if [ -f "$CORE_ENV" ]; then
            for key in SUBREG_LOCATION SUBREG_URI SUBREG_LOGIN SUBREG_PASSWORD; do
                sed -i "/^${key}=/d" "$CORE_ENV"
            done
        fi
        ;;
esac

#DEBHELPER#

exit 0

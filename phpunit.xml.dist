<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/Registration/bootstrap.php"
         colors="true">
    <testsuites>
        <testsuite name="registration">
            <directory>tests/Registration</directory>
        </testsuite>
        <testsuite name="language">
            <directory>tests/Language</directory>
        </testsuite>
        <testsuite name="product">
            <directory>tests/Product</directory>
        </testsuite>
        <testsuite name="search">
            <directory>tests/Search</directory>
        </testsuite>
        <testsuite name="supplier">
            <directory>tests/Supplier</directory>
        </testsuite>
        <testsuite name="contract">
            <directory>tests/Contract</directory>
        </testsuite>
    </testsuites>
</phpunit>
